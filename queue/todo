# kind|name|minutes|command   (see queue/runner.sh)
N|smoke|30|bash exp/smoke.sh
# N1/N2: IR HARQ on UMi at 3, 30, 60 km/h, 40 chunks x 256 slots = 10,240 slots (20,480 blocks) each
N|n1_umi_v3|200|grep -qP "^smoke\t0\t" queue/done ||  { echo smoke did not pass; exit 1; }; bash exp/harq_ir.sh n1_umi_v3 40 --channel UMi --speed 0.83 --ebno 6,8,10,12 --slots 64 --batch 8
N|n1_umi_v3_fill|40|grep -qP "^smoke\t0\t" queue/done ||  { echo smoke did not pass; exit 1; }; bash exp/harq_ir.sh n1_umi_v3 40 --channel UMi --speed 0.83 --ebno 6,8,10,12 --slots 64 --batch 8
N|n1_umi_v30|200|grep -qP "^smoke\t0\t" queue/done ||  { echo smoke did not pass; exit 1; }; bash exp/harq_ir.sh n1_umi_v30 40 --channel UMi --speed 8.33 --ebno 6,8,10,12 --slots 64 --batch 8
N|n1_umi_v60|200|grep -qP "^smoke\t0\t" queue/done ||  { echo smoke did not pass; exit 1; }; bash exp/harq_ir.sh n1_umi_v60 40 --channel UMi --speed 16.67 --ebno 6,8,10,12 --slots 64 --batch 8
# N7: delivery time under three ways to combine recovery with HARQ (login node, from the N1 traces)
L|n7_latency|0|for v in v3 v30 v60; do for lead in 2 4 6; do /global/common/software/nersc/pe/conda-envs/26.8.1/python-3.13/nersc-python/bin/python3 src/sim/harq_latency.py --inputs results/n1_umi_$v/c*.npz --lead $lead --output results/n7_${v}_lead$lead.json; done; done > results/n7_latency.txt 2>&1
# P1/N3: correlation conditions and channel models, 20 chunks = 5,120 slots each
N|p1_umi_los_v3|120|grep -qP "^smoke\t0\t" queue/done ||  { echo smoke did not pass; exit 1; }; bash exp/harq_ir.sh p1_umi_los_v3 20 --channel UMi --los los --speed 0.83 --ebno 6,8,10,12 --slots 64 --batch 8
N|p1_umi_nlos_v3|120|grep -qP "^smoke\t0\t" queue/done ||  { echo smoke did not pass; exit 1; }; bash exp/harq_ir.sh p1_umi_nlos_v3 20 --channel UMi --los nlos --speed 0.83 --ebno 6,8,10,12 --slots 64 --batch 8
N|n3_uma_v3|120|grep -qP "^smoke\t0\t" queue/done ||  { echo smoke did not pass; exit 1; }; bash exp/harq_ir.sh n3_uma_v3 20 --channel UMa --speed 0.83 --ebno 6,8,10,12 --slots 64 --batch 8
N|n3_uma_v30|120|grep -qP "^smoke\t0\t" queue/done ||  { echo smoke did not pass; exit 1; }; bash exp/harq_ir.sh n3_uma_v30 20 --channel UMa --speed 8.33 --ebno 6,8,10,12 --slots 64 --batch 8
N|n3_umi_v120|120|grep -qP "^smoke\t0\t" queue/done ||  { echo smoke did not pass; exit 1; }; bash exp/harq_ir.sh n3_umi_v120 20 --channel UMi --speed 33.33 --ebno 6,8,10,12 --slots 64 --batch 8
# P2: pair similarities of user drops, then pairing policies against the N1 traces (login node)
N|p2_drops|30|bash exp/p2_drops.sh
L|p2_pairing|0|for v in v3 v30 v60; do /global/common/software/nersc/pe/conda-envs/26.8.1/python-3.13/nersc-python/bin/python3 src/sim/pairing.py --traces results/n1_umi_$v/c*.npz --drops results/p2_drops_umi.npz --output results/p2_pairing_umi_$v.json; done > results/p2_pairing.txt 2>&1
# N5: classical strong receivers against the neural receivers on the same slots (needs the LMMSE covariance matrices)
N|n5_cov|60|source env.sh && cd third_party/neural_rx/scripts && tfgen python3 compute_cov_mat.py -config_name nrx_large.cfg -num_samples 100000 -gpu 0
N|n5_umi_v3|150|bash exp/classical.sh n5_umi_v3 --systems baseline_lslin_lmmse,baseline_lmmse_kbest,baseline_perf_csi_kbest,nrx,nrx_rt --ebno 6,8,10,12 --slots 64 --batch 4
# P1 (antennas): where conventional failures come from with 2, 4 and 8 receive antennas
N|p1_ant2|90|bash exp/classical.sh p1_ant2_v3 --num-rx 2 --systems baseline_lslin_lmmse,baseline_perf_csi_kbest --ebno 6,8,10,12 --slots 128 --batch 8
N|p1_ant4|90|bash exp/classical.sh p1_ant4_v3 --num-rx 4 --systems baseline_lslin_lmmse,baseline_perf_csi_kbest --ebno 6,8,10,12 --slots 128 --batch 8
N|p1_ant8|90|bash exp/classical.sh p1_ant8_v3 --num-rx 8 --systems baseline_lslin_lmmse,baseline_perf_csi_kbest --ebno 6,8,10,12 --slots 128 --batch 8
# N6: outer-loop link adaptation over MCS 10-16 on shared channel realizations
N|n6_umi_v3|150|bash exp/harq_mcs.sh n6_umi_v3 24 --channel UMi --speed 0.83 --snr-db 6,8,10,12,14,16 --slots 16 --batch 8
# N9: GPU time of recovery (login node)
L|n9_demand|0|for v in v3 v30 v60; do /global/common/software/nersc/pe/conda-envs/26.8.1/python-3.13/nersc-python/bin/python3 src/sim/demand.py --traces results/n1_umi_$v/c*.npz --output results/n9_demand_$v.json; done > results/n9_demand.txt 2>&1
N|n8a_users|120|bash exp/users.sh n8a_users 0,2,4,6,8,10,12 256
