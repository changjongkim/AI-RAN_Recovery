# P2 again (2026-10-15 evening): the first P2 took failure rates from a table binned by pair similarity only, where
# low similarity goes with weak users.  Now U users are dropped per slot and user 0 is co-scheduled with a partner
# (random, or the best (1 - rho^2) * min gain), and the chosen pairs are generated and decoded like N1.
N|p2b_smoke|20|grep -qP "^smoke\t0\t" queue/done ||  { echo smoke did not pass; exit 1; }; bash exp/harq_ir.sh p2b_smoke 1 --drop-users 8 --pairing partner --channel UMi --speed 0.83 --ebno 8 --slots 32 --batch 8
